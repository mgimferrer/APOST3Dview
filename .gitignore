# Build output: cargo, the packages of scripts/package-*.sh, the built guide
/target
/dist
/docs/book/

# Local test data, never committed: APOST-3D's reference results (copied by
# scripts/sync-apost3d-fixtures.sh) and unpublished test systems
/fixtures/

# Calculation files dropped anywhere for a quick look stay local; the
# committed ones are in validation/ and examples/
*.fchk
*.cube
*.inp
*.xyz
!/validation/**
!/examples/**

# The programs' scratch and job files next to the validation data
*.chk
*.gbw
*.densities
*.densitiesinfo
*.property.txt
*.bibtex
*.plot.tmp
*_atom83.*
/validation/gaussian/*.log
/validation/gaussian/*.com.sh
/validation/qchem/*.sh

# Local notes and tool settings
CLAUDE.md
PROJECT-ROADMAP.md
.claude/
.vscode/
.DS_Store
__pycache__/
*.pyc
