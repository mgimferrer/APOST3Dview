# H2O-ORCA-CAS44-def2SVP: see README.md (ORCA orbital check for APOST3Dview)
! RHF def2-SVP TightSCF
%pal nprocs 48 end
%maxcore 3000
%casscf
  nel 4
  norb 4
end
%plots
  Format Gaussian_Cube
  dim1 80
  dim2 80
  dim3 80
  MO("H2O-ORCA-CAS44-def2SVP-MO4.cube", 4, 0);
  MO("H2O-ORCA-CAS44-def2SVP-MO5.cube", 5, 0);
  ElDens("H2O-ORCA-CAS44-def2SVP-density.cube");
end
* xyz 0 1
O     -0.00000000     0.00000000     0.11920860
H      0.00000000     0.75933700    -0.47683440
H     -0.00000000    -0.75933700    -0.47683440
*
